# Server
PORT=3001
DB_PATH=./data/app.db

# Security (required in production)
JWT_SECRET=change-me

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:5173

# Copilot SDK runtime
COPILOT_SDK_LOG_LEVEL=info

# GitHub OAuth for Copilot SDK user tokens
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://127.0.0.1:3001/api/ai/copilot-sdk/oauth/callback
GITHUB_OAUTH_SCOPES=read:user read:org
GITHUB_OAUTH_REQUIRED_ORG=
GITHUB_OAUTH_AUTHORIZE_URL=https://github.com/login/oauth/authorize
GITHUB_OAUTH_TOKEN_URL=https://github.com/login/oauth/access_token
GITHUB_OAUTH_STATE_SECRET=

# OpenRouter (required for server-managed AI mode)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# Optional: custom path for detailed OpenRouter request/response logs
OPENROUTER_LOG_PATH=./tmp/openrouter-api.log

# GitHub Copilot / GitHub Models client (optional, for copilotClient.js)
# Requires a token with models:read permission.
GITHUB_COPILOT_BASE_URL=https://models.github.ai
GITHUB_COPILOT_API_KEY=
GITHUB_COPILOT_MODEL=gpt-4o-mini
GITHUB_COPILOT_API_VERSION=2026-03-10
# Optional org attribution (uses /orgs/{org}/inference/chat/completions when set)
GITHUB_COPILOT_ORG=

# Cursor SDK AI Analyst Provider
CURSOR_API_KEY=
CURSOR_DEFAULT_MODEL=composer-2.5
CURSOR_WORKSPACE_ROOT=./data/cursor-workspaces
CURSOR_SDK_LOG_LEVEL=info
CURSOR_CHAT_TIMEOUT_MS=300000
CURSOR_REQUIRE_SANDBOX=true
CURSOR_AGENT_CACHE_MAX=50
CURSOR_AGENT_CACHE_TTL_MS=1800000
CURSOR_MAX_CONCURRENT_PER_USER=2
CURSOR_MAX_REQUESTS_PER_USER_HOUR=30

